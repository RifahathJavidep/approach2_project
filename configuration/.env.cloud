# ============================================================================
# CLOUD ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Use these variables in your AWS ECS Task Definition or Secret Manager.

# --- Core API Settings ---
PORT=8000
LOG_LEVEL=INFO

# --- AI & LLM (Groq) ---
GROQ_API_KEY=your_groq_api_key_here

# --- AWS Infrastructure ---
# If running on ECS with an IAM Role, you might not even need these hardcoded
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=katsu-ai-requirement-documents

# --- Redis (ElastiCache) ---
# Use rediss:// for SSL/Encryption in Transit (Standard for ElastiCache)
# Endpoint example: rediss://your-cluster-name.xxxx.use1.cache.amazonaws.com:6379/0
CELERY_BROKER_URL=rediss://your-elasticache-endpoint:6379/0
CELERY_RESULT_BACKEND=rediss://your-elasticache-endpoint:6379/0

# --- Java Backend Connectivity ---
# The URL where your Java Spring Boot backend is reachable from the container
JAVA_BACKEND_URL=http://your-java-backend-lb-or-dns:8080
