# ─────────────────────────────────────────────────────────────────────────────
# Local dev only — copy this file to .env and fill in the values.
#
# In production (Docker / ECS / Kubernetes):
#   - DO NOT use a .env file.
#   - Set AWS_SECRET_ID and AWS_DEFAULT_REGION as environment variables.
#   - All other secrets (GROQ_API_KEY, AWS_ACCESS_KEY_ID, etc.) are loaded
#     automatically from AWS Secret Manager at startup (utils/secrets.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Secret Manager ────────────────────────────────────────────────────────
# The secret must be a JSON object: { "GROQ_API_KEY": "...", "AWS_ACCESS_KEY_ID": "...", ... }
AWS_SECRET_ID=miipe/production
AWS_DEFAULT_REGION=us-east-1

# Set to "true" in production so secrets.py warns if keys fall back to env vars
IS_DEPLOYED=false

# ── AWS credentials (local dev — use IAM role in production, not these keys) ─
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your-prism-s3-bucket

# ── LLM (local dev — loaded from Secret Manager in production) ────────────────
GROQ_API_KEY=your_groq_api_key

# ── Celery broker ─────────────────────────────────────────────────────────────
# Local dev: use local Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Production (AWS ElastiCache, SSL required — use rediss:// prefix):
# CELERY_BROKER_URL=rediss://your-cluster.serverless.use1.cache.amazonaws.com:6379/0
# CELERY_RESULT_BACKEND=rediss://your-cluster.serverless.use1.cache.amazonaws.com:6379/1

# ── Keycloak (authentication & tenant isolation) ──────────────────────────────
# Keycloak server and realm — must match Java application.yaml
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=miipe
# Tenant prefix — must match Java config (katsu.config.keycloak.tenant-prefix)
KEYCLOAK_TENANT_PREFIX=tenant_

# Client secrets — each service has its own Keycloak client with its own secret.
# Get each from: Keycloak Admin → switch to miipe realm → Clients → <client> → Credentials tab
#
# Client: extracter-service  (br-creation-service port 8001)
KEYCLOAK_EXTRACTION_CLIENT_SECRET=your_extraction_client_secret_here
# Client: testcase-service-ai  (testcase-generation-service port 8002)
KEYCLOAK_TESTCASE_CLIENT_SECRET=your_testcase_client_secret_here
# Client: manual-service  (br-manual-creation-service port 8003)
KEYCLOAK_MANUAL_CLIENT_SECRET=your_manual_client_secret_here

# ── Java Backend (port 8081, NOT 8080 — that's Keycloak) ──────────────────────
JAVA_BACKEND_URL=http://localhost:8081

# ── TestGen service (br-creation-service uses this to trigger test generation) ─
TESTGEN_SERVICE_URL=http://localhost:8002

# ── FTP (optional — only if document ingestion via FTP is enabled) ────────────
FTP_HOST=your_ftp_host
FTP_PORT=21
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password
FTP_DIRECTORY=/documents

# ── PostgreSQL (used by docker-compose.deploy.yml for java-api) ───────────────
DB_URL=jdbc:postgresql://postgres.svc:5432/prism
DB_USER=your_db_username
DB_PASS=your_db_password
