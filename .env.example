# ─────────────────────────────────────────────────────────────────────────────
# Local dev only — copy this file to .env and fill in the values.
#
# In production (Docker / ECS / Kubernetes):
#   - DO NOT use a .env file.
#   - Set AWS_SECRET_ID and AWS_DEFAULT_REGION as environment variables.
#   - All other secrets (GROQ_API_KEY, AWS_ACCESS_KEY_ID, etc.) are loaded
#     automatically from AWS Secret Manager at startup (utils/secrets.py).
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Secret Manager ────────────────────────────────────────────────────────
# The secret must be a JSON object: { "GROQ_API_KEY": "...", "AWS_ACCESS_KEY_ID": "...", ... }
AWS_SECRET_ID=miipe/production
AWS_DEFAULT_REGION=us-east-1

# Set to "true" in production so secrets.py warns if keys fall back to env vars
IS_DEPLOYED=false

# ── AWS credentials (local dev — use IAM role in production, not these keys) ─
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET_NAME=your-prism-s3-bucket

# ── LLM (local dev — loaded from Secret Manager in production) ────────────────
GROQ_API_KEY=your_groq_api_key

# ── Celery broker ─────────────────────────────────────────────────────────────
# Local dev: use local Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Production (AWS ElastiCache, SSL required — use rediss:// prefix):
# CELERY_BROKER_URL=rediss://your-cluster.serverless.use1.cache.amazonaws.com:6379/0
# CELERY_RESULT_BACKEND=rediss://your-cluster.serverless.use1.cache.amazonaws.com:6379/1

# ── Java Backend ───────────────────────────────────────────────────────────────
JAVA_BACKEND_URL=http://localhost:8081

# ── TestGen service (extraction-service uses this to trigger test generation) ─
TESTGEN_SERVICE_URL=http://localhost:8002

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to use the v4.0 enrichment-pass BR extraction pipeline
USE_V4_BR_EXTRACTION=false

# ── FTP (optional — only if document ingestion via FTP is enabled) ────────────
FTP_HOST=your_ftp_host
FTP_PORT=21
FTP_USER=your_ftp_user
FTP_PASSWORD=your_ftp_password
FTP_DIRECTORY=/documents
