# Copy this file to .env and fill in your values
# docker-compose.yml loads .env automatically for all services

# ── Redis (shared by both services) ─────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── AWS ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=your-prism-bucket

# ── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── Java Backend ─────────────────────────────────────────────────────────────
JAVA_BACKEND_URL=http://your-java-backend:8080

# ── Inter-service (set automatically by docker-compose, override if needed) ──
# TESTGEN_SERVICE_URL=http://testgen-api:8001
